# Optional for local development. Production Vercel deployments require this
# shared PostgreSQL URL so jury and operator requests see the same state.
DATABASE_URL=postgresql://sentinel:change-me@localhost:5432/sentinel

# Optional comma-separated browser origins for LAN previews or split deployments.
# Same-origin Vercel traffic does not require an additional entry.
SENTINEL_CORS_ORIGINS=http://192.168.1.120:5173

# Optional frontend overrides. Leave blank for same-origin production routing.
VITE_SENTINEL_API_URL=
VITE_PUBLIC_APP_URL=

# Local simulation controls. Replace these before any non-demo deployment.
SENTINEL_INGESTION_TOKEN=sentinel-sim-ingest
SENTINEL_DATABASE_PATH=sentinel.db
